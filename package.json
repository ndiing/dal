    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@ndiinginc/test": "^1.0.0",
        "@types/jest": "^30.0.0",
        "better-sqlite3": "^13.0.3",
        "jest": "^30.5.2",
        "msnodesqlv8": "^5.5.0",
        "mssql": "^12.7.2",
        "pg": "^8.23.0",
        "typescript": "^7.0.2"
    },
    "directories": {
        "test": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ndiing/dal.git"
    },
