{
    "name": "@ndiinginc/dal",
    "version": "1.3.0",
    "description": "A lightweight, chainable SQL query builder, schema builder, migration runner, and repository layer for Node.js.",
    "main": "./src/database.js",
    "types": "./types/database.d.ts",
    "scripts": {
        "test": "nodemon --exec \"node -e \\\"require('@ndiinginc/test')(require('path').join(process.cwd(),'tests'),{verbose:true})\\\"\"",
        "dev": "nodemon src/index.js",
        "prettier": "npx prettier . --write",
        "commit": "node scripts/commit.js",
        "npm:dry-run": "npm publish --dry-run",
        "npm:login": "npm login",
        "npm:publish": "npm publish --access public",
        "tsc": "npx tsc"
    },
    "keywords": [],
